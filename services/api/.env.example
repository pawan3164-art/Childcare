# Local dev only. Copy to .env and adjust if needed. Never commit real secrets here.

# Used by Prisma Migrate (schema owner / superuser-ish role).
DATABASE_URL="postgresql://childcare:childcare_dev_only@localhost:55432/childcare?schema=public"

# Used by the running application at request time (restricted role, RLS-enforced,
# created by the enable_rls migration). No BYPASSRLS, no UPDATE/DELETE on audit_log_entries.
DATABASE_APP_URL="postgresql://childcare_app:childcare_app_dev_only@localhost:55432/childcare?schema=public"

# Photo storage (ADR 0004). Points at the MinIO container in infra/docker-compose.dev.yml.
# Leave S3_BUCKET empty to keep photos in memory (lost on restart). In AWS, set
# S3_BUCKET and S3_REGION only; credentials come from the task role.
S3_BUCKET=childcare-media-dev
S3_REGION=ap-southeast-2
S3_ENDPOINT=http://localhost:59000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=childcare
S3_SECRET_ACCESS_KEY=childcare_dev_only

PORT=3000
JWT_SECRET="dev-only-change-me"
JWT_EXPIRES_IN="15m"

# Optional. Leave unset to no-op (no Sentry account needed for local dev).
SENTRY_DSN=

# Optional. Leave unset to export no traces (no collector needed for local dev).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional, non-production only: set to 1 to pretty-print every span to stdout
# when no collector is configured. Very verbose — debugging only.
OTEL_TRACES_CONSOLE=
