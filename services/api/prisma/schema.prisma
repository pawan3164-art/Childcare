// Next-Gen Childcare Platform — Stage 0 domain model.
// Tenancy pattern: org_id (and centre_id where applicable) is denormalized onto
// every tenant-scoped row and enforced by Postgres row-level security (see the
// RLS migration in prisma/migrations/*_enable_rls/migration.sql). Application
// code must never rely solely on WHERE clauses for isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  ORG_ADMIN
  CENTRE_ADMIN
  EDUCATOR
  PARENT
}

enum RelationshipType {
  PARENT
  GUARDIAN
  AUTHORIZED_PICKUP
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

enum SyncOperationType {
  CREATE
  UPDATE
  DELETE
}

enum SyncOperationStatus {
  APPLIED
  CONFLICT
  REJECTED
}

enum NotificationPriority {
  URGENT
  ACTION_REQUIRED
  CHILD_UPDATE
  GENERAL
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  ACKNOWLEDGED
  FAILED
}

enum AttendanceEventType {
  SIGN_IN
  SIGN_OUT
}

enum AttendanceMethod {
  KIOSK
  QR
  PIN
  EDUCATOR
}

enum CareRecordType {
  MEAL
  SLEEP
  TOILETING
  BOTTLE
  ACTIVITY
}

enum AdministrationStatus {
  CONFIRMED
  PENDING_REVIEW
  REJECTED
}

enum IncidentSeverity {
  MINOR
  MODERATE
  SERIOUS
}

enum IncidentReviewStatus {
  OPEN
  ACKNOWLEDGED
  REVIEWED
}

enum MessageScope {
  ROOM
  CENTRE
  EMERGENCY
}

enum FeeType {
  SESSION
  DAILY
}

enum BookingType {
  PERMANENT
  CASUAL
}

enum LedgerEntryType {
  FEE
  SUBSIDY_ESTIMATED
  SUBSIDY_CONFIRMED
  PAYMENT
  ADJUSTMENT
  CREDIT
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
}

enum CcsSessionReportStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Organisation {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  centres Centre[]
  users   User[]

  @@map("organisations")
}

model Centre {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  timezone  String   @default("Australia/Sydney")
  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [orgId], references: [id])
  rooms        Room[]
  children     Child[]

  @@index([orgId])
  @@map("centres")
}

model Room {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  centreId    String   @map("centre_id")
  name        String
  ageBandMin  Int?     @map("age_band_min_months")
  ageBandMax  Int?     @map("age_band_max_months")
  createdAt   DateTime @default(now()) @map("created_at")

  centre   Centre  @relation(fields: [centreId], references: [id])
  children Child[]

  @@index([orgId])
  @@index([centreId])
  @@map("rooms")
}

model Child {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  centreId    String    @map("centre_id")
  roomId      String?   @map("room_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  dateOfBirth DateTime  @map("date_of_birth") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at")
  /// The family consents to this child appearing in group photos that other
  /// families can see (BRD §17). Off until recorded; changes are audit-logged.
  groupPhotoConsent          Boolean   @default(false) @map("group_photo_consent")
  groupPhotoConsentUpdatedAt DateTime? @map("group_photo_consent_updated_at")
  groupPhotoConsentUpdatedBy String?   @map("group_photo_consent_updated_by")

  centre           Centre                      @relation(fields: [centreId], references: [id])
  room             Room?                       @relation(fields: [roomId], references: [id])
  relationships    GuardianChildRelationship[]
  attendanceEvents AttendanceEvent[]
  careRecords      CareRecord[]
  mediaTags        MediaAssetChildTag[]
  medicationAuthorizations MedicationAuthorization[]
  incidents        Incident[]
  bookings         Booking[]
  absences         Absence[]
  ccsEntitlements  CcsEntitlement[]
  invoices         Invoice[]
  ccsEnrolments    CcsEnrolment[]

  @@index([orgId])
  @@index([centreId])
  @@map("children")
}

/// Staff and parent accounts. A PARENT user may have orgId/centreId null until
/// linked to a child via GuardianChildRelationship (which carries its own
/// org/centre for RLS, since a parent can have children at multiple centres).
model User {
  id           String    @id @default(uuid())
  orgId        String?   @map("org_id")
  centreId     String?   @map("centre_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  mfaSecret    String?   @map("mfa_secret")
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  createdAt    DateTime  @default(now()) @map("created_at")

  organisation  Organisation?               @relation(fields: [orgId], references: [id])
  sessions      Session[]
  relationships GuardianChildRelationship[]
  roomAssignments StaffRoomAssignment[]

  @@index([orgId])
  @@index([centreId])
  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model StaffRoomAssignment {
  id        String    @id @default(uuid())
  orgId     String    @map("org_id")
  centreId  String    @map("centre_id")
  userId    String    @map("user_id")
  roomId    String    @map("room_id")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  user User @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@map("staff_room_assignments")
}

/// The core relationship-based access control primitive (BRD §22, Delivery Plan §6.2):
/// access to a child is granted per-relationship, not just by role.
model GuardianChildRelationship {
  id               String           @id @default(uuid())
  orgId            String           @map("org_id")
  centreId         String           @map("centre_id")
  guardianUserId   String           @map("guardian_user_id")
  childId          String           @map("child_id")
  relationshipType RelationshipType @map("relationship_type")
  canViewMedia     Boolean          @default(true) @map("can_view_media")
  canViewBilling   Boolean          @default(false) @map("can_view_billing")
  canPickup        Boolean          @default(false) @map("can_pickup")
  isRestricted     Boolean          @default(false) @map("is_restricted")
  expiresAt        DateTime?        @map("expires_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  guardian User  @relation(fields: [guardianUserId], references: [id])
  child    Child @relation(fields: [childId], references: [id])

  @@unique([guardianUserId, childId])
  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("guardian_child_relationships")
}

/// Append-only. No update/delete is exposed anywhere in application code —
/// enforced additionally at the DB level by REVOKE UPDATE/DELETE in the RLS migration.
model AuditLogEntry {
  id           String       @id @default(uuid())
  orgId        String?      @map("org_id")
  centreId     String?      @map("centre_id")
  timestamp    DateTime     @default(now())
  actorUserId  String?      @map("actor_user_id")
  actorRole    UserRole?    @map("actor_role")
  action       String
  entityType   String       @map("entity_type")
  entityId     String?      @map("entity_id")
  outcome      AuditOutcome
  metadata     Json?
  correlationId String?     @map("correlation_id")

  @@index([orgId])
  @@index([centreId])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log_entries")
}

/// Offline-sync operation ledger. idempotencyKey makes re-submission of the
/// same client operation a no-op (server applies each exactly once).
model SyncOperation {
  id                 String              @id @default(uuid())
  orgId              String              @map("org_id")
  centreId           String              @map("centre_id")
  idempotencyKey     String              @unique @map("idempotency_key")
  clientOperationId  String              @map("client_operation_id")
  entityType         String              @map("entity_type")
  entityId           String              @map("entity_id")
  operationType      SyncOperationType   @map("operation_type")
  payload            Json
  authorUserId       String              @map("author_user_id")
  clientTimestamp    DateTime            @map("client_timestamp")
  serverTimestamp    DateTime            @default(now()) @map("server_timestamp")
  status             SyncOperationStatus
  conflictReason     String?             @map("conflict_reason")

  @@index([orgId])
  @@index([centreId])
  @@index([entityType, entityId])
  @@map("sync_operations")
}

model NotificationQueueItem {
  id              String               @id @default(uuid())
  orgId           String               @map("org_id")
  centreId        String?              @map("centre_id")
  recipientUserId String               @map("recipient_user_id")
  priority        NotificationPriority
  channel         NotificationChannel
  payload         Json
  status          NotificationStatus   @default(QUEUED)
  createdAt       DateTime             @default(now()) @map("created_at")
  sentAt          DateTime?            @map("sent_at")
  deliveredAt     DateTime?            @map("delivered_at")
  openedAt        DateTime?            @map("opened_at")
  acknowledgedAt  DateTime?            @map("acknowledged_at")

  @@index([orgId])
  @@index([recipientUserId])
  @@index([status])
  @@map("notification_queue_items")
}

/// Append-only (Delivery Plan §6.1: "attendance sign-out is server-wins with
/// an admin flag" — a correction is a new row with correctedEventId pointing
/// at what it supersedes, never an UPDATE of history).
model AttendanceEvent {
  id                String              @id @default(uuid())
  orgId             String              @map("org_id")
  centreId          String              @map("centre_id")
  childId           String              @map("child_id")
  eventType         AttendanceEventType @map("event_type")
  method            AttendanceMethod
  timestamp         DateTime
  recordedByUserId  String?             @map("recorded_by_user_id")
  isCorrection      Boolean             @default(false) @map("is_correction")
  correctedEventId  String?             @map("corrected_event_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@index([childId, timestamp])
  @@map("attendance_events")
}

/// Append-only care records (BRD §9 group-first logging). A single group
/// action (e.g. "12 children had morning tea") produces one CareRecord row
/// per child, all sharing groupEventId, so exceptions can be edited per-child
/// without re-recording everyone else. Never updated once created — a
/// correction is a new row with correctedRecordId.
model CareRecord {
  id                 String         @id @default(uuid())
  orgId              String         @map("org_id")
  centreId           String         @map("centre_id")
  childId            String         @map("child_id")
  type               CareRecordType
  timestamp          DateTime
  note               String?
  groupEventId       String         @map("group_event_id")
  recordedByUserId   String         @map("recorded_by_user_id")
  isCorrection       Boolean        @default(false) @map("is_correction")
  correctedRecordId  String?        @map("corrected_record_id")
  createdAt          DateTime       @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@index([childId, timestamp])
  @@index([groupEventId])
  @@map("care_records")
}

/// A photo/video. Visibility to a parent requires canViewMedia on the
/// relationship for EVERY tagged child (BRD §17: "media with several children
/// shows to a family only if every tagged child's permissions allow it") —
/// enforced in MediaService, not by a DB constraint, since it depends on the
/// viewing guardian's own relationships.
model MediaAsset {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  centreId         String   @map("centre_id")
  roomId           String?  @map("room_id")
  storageKey       String   @map("storage_key")
  /// Set on upload (ADR 0004); null for Stage 1 rows registered without bytes.
  contentType      String?  @map("content_type")
  byteSize         Int?     @map("byte_size")
  width            Int?
  height           Int?
  capturedByUserId String   @map("captured_by_user_id")
  capturedAt       DateTime @default(now()) @map("captured_at")

  childTags MediaAssetChildTag[]

  @@index([orgId])
  @@index([centreId])
  @@map("media_assets")
}

model MediaAssetChildTag {
  id           String @id @default(uuid())
  orgId        String @map("org_id")
  mediaAssetId String @map("media_asset_id")
  childId      String @map("child_id")

  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])
  child      Child      @relation(fields: [childId], references: [id])

  @@unique([mediaAssetId, childId])
  @@index([orgId])
  @@index([childId])
  @@map("media_asset_child_tags")
}

/// Standing authorization for a medication (BRD §14). Administrations are
/// append-only events against an authorization, never edits of the
/// authorization itself.
model MedicationAuthorization {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  centreId             String    @map("centre_id")
  childId              String    @map("child_id")
  medicationName       String    @map("medication_name")
  dosageInstructions   String    @map("dosage_instructions")
  authorizedByGuardianId String  @map("authorized_by_guardian_id")
  expiresAt            DateTime? @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  child           Child                     @relation(fields: [childId], references: [id])
  administrations MedicationAdministration[]

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("medication_authorizations")
}

/// Append-only. The hard-conflict rule (Delivery Plan §6.1: "medication
/// administration is a hard conflict needing human review — double-dose
/// risk") lives in MedicationService.recordAdministration: a second
/// administration against the same authorization within the configured
/// window is stored as PENDING_REVIEW, never silently auto-applied like an
/// attendance or care-record event would be.
model MedicationAdministration {
  id                 String               @id @default(uuid())
  orgId              String               @map("org_id")
  centreId           String               @map("centre_id")
  authorizationId    String               @map("authorization_id")
  administeredByUserId String             @map("administered_by_user_id")
  administeredAt     DateTime             @map("administered_at")
  dosageGiven        String               @map("dosage_given")
  notes              String?
  status             AdministrationStatus @default(CONFIRMED)
  reviewedByUserId   String?              @map("reviewed_by_user_id")
  reviewedAt         DateTime?            @map("reviewed_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  authorization MedicationAuthorization @relation(fields: [authorizationId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@index([authorizationId, administeredAt])
  @@map("medication_administrations")
}

/// Immutable once finalized (BRD §14, §22: "critical records must retain an
/// audit history" / incidents require "immutable audit history"). A
/// correction after review is a new linked row (correctedIncidentId), the
/// original is never edited — the DB grant for childcare_app has no UPDATE
/// on this table, matching audit_log_entries and the Stage 1 append-only tables.
model Incident {
  id                  String                @id @default(uuid())
  orgId               String                @map("org_id")
  centreId            String                @map("centre_id")
  childId             String                @map("child_id")
  severity            IncidentSeverity
  description         String
  occurredAt          DateTime              @map("occurred_at")
  reportedByUserId    String                @map("reported_by_user_id")
  reviewStatus        IncidentReviewStatus  @default(OPEN) @map("review_status")
  reviewedByUserId    String?               @map("reviewed_by_user_id")
  reviewedAt          DateTime?             @map("reviewed_at")
  reviewNotes         String?               @map("review_notes")
  correctedIncidentId String?               @map("corrected_incident_id")
  createdAt           DateTime              @default(now()) @map("created_at")

  child           Child                    @relation(fields: [childId], references: [id])
  acknowledgements IncidentAcknowledgement[]

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("incidents")
}

model IncidentAcknowledgement {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  incidentId     String   @map("incident_id")
  guardianUserId String   @map("guardian_user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  incident Incident @relation(fields: [incidentId], references: [id])

  @@unique([incidentId, guardianUserId])
  @@index([orgId])
  @@map("incident_acknowledgements")
}

/// Centre/room messaging and emergency broadcast (BRD §16). Acknowledgement
/// tracking on EMERGENCY-scope messages supports the "acknowledgement
/// tracking" requirement in BRD §12 Communication.
model Message {
  id        String       @id @default(uuid())
  orgId     String       @map("org_id")
  centreId  String       @map("centre_id")
  roomId    String?      @map("room_id")
  scope     MessageScope
  authorUserId String    @map("author_user_id")
  body      String
  createdAt DateTime     @default(now()) @map("created_at")

  acknowledgements MessageAcknowledgement[]

  @@index([orgId])
  @@index([centreId])
  @@map("messages")
}

model MessageAcknowledgement {
  id             String   @id @default(uuid())
  orgId          String   @map("org_id")
  messageId      String   @map("message_id")
  userId         String   @map("user_id")
  acknowledgedAt DateTime @default(now()) @map("acknowledged_at")

  message Message @relation(fields: [messageId], references: [id])

  @@unique([messageId, userId])
  @@index([orgId])
  @@map("message_acknowledgements")
}

/// BIL-001: fee schedules per centre/room/age band with effective dates.
model FeeSchedule {
  id                   String    @id @default(uuid())
  orgId                String    @map("org_id")
  centreId             String    @map("centre_id")
  roomId               String?   @map("room_id")
  name                 String
  feeType              FeeType   @map("fee_type")
  amountCents          Int       @map("amount_cents")
  ageBandMinMonths     Int?      @map("age_band_min_months")
  ageBandMaxMonths     Int?      @map("age_band_max_months")
  siblingDiscountPercent Int     @default(0) @map("sibling_discount_percent")
  effectiveFrom        DateTime  @map("effective_from") @db.Date
  effectiveTo          DateTime? @map("effective_to") @db.Date
  createdAt            DateTime  @default(now()) @map("created_at")

  bookings Booking[]

  @@index([orgId])
  @@index([centreId])
  @@map("fee_schedules")
}

/// BIL-002: permanent (recurring by day-of-week) or casual (single date) bookings.
model Booking {
  id            String      @id @default(uuid())
  orgId         String      @map("org_id")
  centreId      String      @map("centre_id")
  childId       String      @map("child_id")
  roomId        String      @map("room_id")
  feeScheduleId String      @map("fee_schedule_id")
  bookingType   BookingType @map("booking_type")
  daysOfWeek    Int[]       @map("days_of_week") // 0=Sunday..6=Saturday; used when PERMANENT
  specificDate  DateTime?   @map("specific_date") @db.Date // used when CASUAL
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime?   @map("end_date") @db.Date
  createdAt     DateTime    @default(now()) @map("created_at")

  child       Child       @relation(fields: [childId], references: [id])
  feeSchedule FeeSchedule @relation(fields: [feeScheduleId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("bookings")
}

/// BIL-002: allowable absences don't generate a fee; non-allowable ones still do.
model Absence {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  centreId    String   @map("centre_id")
  childId     String   @map("child_id")
  date        DateTime @db.Date
  isAllowable Boolean  @map("is_allowable")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id])

  @@unique([childId, date])
  @@index([orgId])
  @@index([centreId])
  @@map("absences")
}

/// Estimated-only in Stage 3 (BIL-004) — government-confirmed amounts arrive
/// via the Stage 4 CCS module as a separate SUBSIDY_CONFIRMED ledger entry,
/// never by editing this record or the original estimate.
model CcsEntitlement {
  id                      String    @id @default(uuid())
  orgId                   String    @map("org_id")
  centreId                String    @map("centre_id")
  childId                 String    @map("child_id")
  estimatedSubsidyPercent Int       @map("estimated_subsidy_percent")
  effectiveFrom           DateTime  @map("effective_from") @db.Date
  effectiveTo             DateTime? @map("effective_to") @db.Date
  createdAt               DateTime  @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("ccs_entitlements")
}

/// BIL-003: an issued invoice is an immutable header — no UPDATE/DELETE grant
/// at all. It never stores totals; totals are derived by summing the
/// LedgerEntry rows that reference it (BRD §22: "issued invoices are
/// immutable; changes are made through credits/adjustments").
model Invoice {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  centreId   String   @map("centre_id")
  childId    String   @map("child_id")
  cycleStart DateTime @map("cycle_start") @db.Date
  cycleEnd   DateTime @map("cycle_end") @db.Date
  issuedAt   DateTime @default(now()) @map("issued_at")

  child   Child         @relation(fields: [childId], references: [id])
  entries LedgerEntry[]

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("invoices")
}

/// Delivery Plan §6.3: "fees, estimated subsidy, confirmed subsidy, payments
/// and adjustments are separate entries, never overwritten." Append-only —
/// no UPDATE/DELETE grant. amountCents sign convention: FEE and ADJUSTMENT
/// (debit) are positive; SUBSIDY_ESTIMATED, SUBSIDY_CONFIRMED, PAYMENT and
/// CREDIT (reduce balance owed) are stored negative. sourceFeeEntryId links a
/// subsidy entry to the FEE entry it offsets, so LedgerService can prefer a
/// CONFIRMED subsidy over its ESTIMATED counterpart for the same fee instead
/// of double-counting both.
model LedgerEntry {
  id               String          @id @default(uuid())
  orgId            String          @map("org_id")
  centreId         String          @map("centre_id")
  childId          String          @map("child_id")
  invoiceId        String?         @map("invoice_id")
  entryType        LedgerEntryType @map("entry_type")
  amountCents      Int             @map("amount_cents")
  description      String
  sessionDate      DateTime?       @map("session_date") @db.Date
  sourceFeeEntryId String?         @map("source_fee_entry_id")
  reasonCode       String?         @map("reason_code")
  createdByUserId  String?         @map("created_by_user_id")
  createdAt        DateTime        @default(now()) @map("created_at")

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@index([invoiceId])
  @@index([sourceFeeEntryId])
  @@map("ledger_entries")
}

/// Mocked gateway record (OI-06 — real gateway TBD). providerPaymentId is
/// unique so a duplicate/replayed webhook can never double-credit an account
/// (Delivery Plan §6.3).
/// BIL-004/BIL-005: enrolment/entitlement reference data for a child's CCS
/// claim. Isolated from the rest of billing (Delivery Plan R4: "Isolated
/// module with its own queue, retries, audit trail and replay tool, so a
/// government outage can never block care workflows") -- the care loop and
/// even fee/invoice generation (Stage 3) function with zero dependency on
/// this table being populated or the gateway being reachable.
model CcsEnrolment {
  id                 String   @id @default(uuid())
  orgId              String   @map("org_id")
  centreId           String   @map("centre_id")
  childId            String   @map("child_id")
  ccsEnrolmentRef    String   @map("ccs_enrolment_ref") // government-issued reference, opaque to us
  createdAt          DateTime @default(now()) @map("created_at")

  child          Child               @relation(fields: [childId], references: [id])
  sessionReports CcsSessionReport[]

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("ccs_enrolments")
}

/// Append-only. Each row is one submission ATTEMPT -- a resubmission after a
/// rejection creates a NEW row (attemptNumber incremented), never edits the
/// rejected one, so the full back-and-forth with Services Australia stays
/// auditable (BRD §15: "maintain reconciliation/audit records for relevant
/// transactions and data exchanges").
model CcsSessionReport {
  id                     String                  @id @default(uuid())
  orgId                  String                  @map("org_id")
  centreId               String                  @map("centre_id")
  enrolmentId            String                  @map("enrolment_id")
  sessionDate            DateTime                @map("session_date") @db.Date
  hours                  Float
  attemptNumber          Int                     @default(1) @map("attempt_number")
  status                 CcsSessionReportStatus  @default(PENDING)
  confirmedSubsidyCents  Int?                    @map("confirmed_subsidy_cents")
  rejectionReason        String?                 @map("rejection_reason")
  providerResponseRef    String?                 @map("provider_response_ref")
  submittedAt            DateTime                @default(now()) @map("submitted_at")
  resolvedAt             DateTime?               @map("resolved_at")
  resultingLedgerEntryId String?                 @map("resulting_ledger_entry_id")

  enrolment CcsEnrolment @relation(fields: [enrolmentId], references: [id])

  @@index([orgId])
  @@index([centreId])
  @@index([enrolmentId])
  @@map("ccs_session_reports")
}

model PaymentRecord {
  id                String        @id @default(uuid())
  orgId             String        @map("org_id")
  centreId          String        @map("centre_id")
  childId           String        @map("child_id")
  provider          String        @default("MOCK")
  providerPaymentId String        @unique @map("provider_payment_id")
  amountCents       Int           @map("amount_cents")
  status            PaymentStatus
  ledgerEntryId     String?       @map("ledger_entry_id")
  receivedAt        DateTime      @default(now()) @map("received_at")

  @@index([orgId])
  @@index([centreId])
  @@index([childId])
  @@map("payment_records")
}
