# Copy to infra/prod/.env on the VPS. deploy.sh generates the secrets for you
# if you leave them blank. Never commit the real file (.env is gitignored).
DOMAIN=justforfewtests.in
ACME_EMAIL=you@example.com

# Generated by deploy.sh if empty (hex only, so they are URL-safe).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
DOMAIN_CHECK_TOKEN=

# Optional.
SENTRY_DSN=

# Optional. Admin MFA: 'required' forces authenticator-app enrolment before sign-in (set before real families).
MFA_ENFORCEMENT=off
# Optional session lengths: staff hours, parent days (refresh never extends them).
SESSION_MAX_HOURS_STAFF=12
SESSION_MAX_DAYS_PARENT=30
