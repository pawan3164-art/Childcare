# Copy to infra/prod/.env on the VPS. deploy.sh generates the secrets for you
# if you leave them blank. Never commit the real file (.env is gitignored).
DOMAIN=justforfewtests.in
ACME_EMAIL=you@example.com

# Generated by deploy.sh if empty (hex only, so they are URL-safe).
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional.
SENTRY_DSN=

# Optional. Access-token lifetime for the pilot (default 12h; no refresh tokens yet).
JWT_EXPIRES_IN=12h
