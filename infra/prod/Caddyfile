# Caddy obtains and renews Let's Encrypt certificates automatically.
# DNS A records for api., portal. and media. must point at this VPS first.
{
	email {$ACME_EMAIL}
	# White label level 2: an organisation can serve the portal from its own domain. Caddy asks the API whether a
	# hostname is registered and verified before it requests a certificate, so strangers cannot make it issue one.
	on_demand_tls {
		ask http://api:3000/branding/domain-check?token={$DOMAIN_CHECK_TOKEN}
	}
}

api.{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	reverse_proxy api:3000
}

portal.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy portal:3001
}

# Photos are served from the private bucket via 5-minute presigned URLs (ADR 0004).
# The signature is bound to this hostname, so the API must use this same URL as
# S3_ENDPOINT. Unsigned requests are rejected by SeaweedFS.
media.{$DOMAIN} {
	reverse_proxy s3:8333
}

# Any other hostname that passed the check above: an organisation's own portal domain.
# DNS for it must point at this server (CNAME to portal.{$DOMAIN}) and its TXT record must be verified in the portal.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy portal:3001
}
