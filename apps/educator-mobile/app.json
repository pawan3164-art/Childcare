{
  "expo": {
    "name": "Childcare Educator",
    "slug": "educator-mobile",
    "scheme": "childcare-educator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "in.justforfewtests.educator"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos of today's activities to share with families.",
          "cameraPermission": "Take photos of today's activities to share with families."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32d66212-54cb-479a-810a-b1b632b243cc"
      }
    },
    "owner": "pawan3164s-team"
  }
}
